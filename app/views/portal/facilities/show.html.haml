%nav{ "aria-label": "breadcrumb" }
  %ol.breadcrumb
    %li.breadcrumb-item= link_to "Facilities", portal_dashboard_path
    %li.breadcrumb-item.active{ "aria-current": "page" }= @facility.name

%h1.h4.mb-1= @facility.name
%p.text-muted.mb-4= @facility.venue.name

= turbo_frame_tag "facility_verification_card" do
  .card{ data: { controller: "facility-polling", "facility-polling-url-value": portal_facility_path(@facility) } }
    .card-header.d-flex.justify-content-between.align-items-center
      %h2.h6.mb-0 Upcoming Bookings (Next 7 Days)
      .spinner-border.spinner-border-sm.text-muted.d-none{ "data-facility-polling-target": "spinner", role: "status" }
        %span.visually-hidden Loading...

    .card-body
      - if @booking_instances.any?
        - @booking_instances.group_by { |b| b.starts_at.to_date }.each do |date, bookings|
          %section.mb-4{ "aria-label": "Bookings for #{date.strftime("%A, %B %-d")}" }
            %h3.h6.text-secondary.mb-2= date.strftime("%A, %B %-d")

            %ul.list-group
              - bookings.each do |booking|
                %li.list-group-item.d-flex.justify-content-between.align-items-center{ tabindex: "0", "aria-label": "Booking at #{booking.starts_at.strftime("%-I:%M %p")}, status: #{booking.verification_status}" }
                  %span.font-weight-medium= booking.starts_at.strftime("%-I:%M %p")
                  
                  %div{ id: "booking_#{booking.id}_badge" }
                    = render "shared/verification_badge", status: booking.verification_status
      - else
        .text-center.text-muted.py-5{ "aria-live": "polite" }
          %p.mb-0 No bookings in the next 7 days.