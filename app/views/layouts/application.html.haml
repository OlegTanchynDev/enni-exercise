!!!
%html{ lang: "en" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title Enni — Cleaning Verification
    = csrf_meta_tags
    = csp_meta_tag
    %link{ rel: "icon", href: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23664fc3'/%3E%3C/svg%3E" }
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "" }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap" }
    %link{ rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" }
    %link{ rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" }
    = stylesheet_link_tag "application"
    = javascript_importmap_tags
  %body
    %nav.navbar.navbar-expand.enni-navbar.py-2
      .container
        = link_to root_path, class: "navbar-brand enni-brand mb-0 d-inline-flex align-items-center gap-1" do
          %i.bi.bi-geo-alt-fill
          enni
        - if user_signed_in?
          .navbar-nav.ms-auto.flex-row.align-items-center.gap-3
            %span.text-muted.small= current_user.name
            = button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-secondary", form: { class: "d-inline-block" }
    %main.container.py-4
      - if notice
        .alert.alert-success{ role: "alert" }= notice
      - if alert
        .alert.alert-warning{ role: "alert" }= alert
      = yield
    %script{ src: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" }
